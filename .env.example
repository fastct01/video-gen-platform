# ---- Core ----
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://video:video@localhost:5432/video
REDIS_URL=redis://localhost:6379
# Protects /admin/* (create users, credit tokens). Use a long random string.
ADMIN_TOKEN=change-me-admin-token
# Signs download URLs for the local storage driver.
URL_SIGNING_SECRET=change-me-signing-secret

# ---- Providers ----
# Which provider new videos use when the request doesn't specify one.
DEFAULT_PROVIDER=gemini
# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-omni-1.2-flash
GEMINI_TOKENS_PER_SECOND=10
# Local fake provider for testing the whole pipeline without spending money.
MOCK_PROVIDER_ENABLED=true
MOCK_TOKENS_PER_SECOND=1
MOCK_DELAY_MS=1500
MOCK_FAILURE_RATE=0

# Starting tokens for the local UI user, created when you paste a Gemini key or the admin token into the UI.
LOCAL_USER_INITIAL_TOKENS=1000

# ---- Generation limits ----
DEFAULT_SEGMENT_SECONDS=8
MAX_SEGMENTS_PER_VIDEO=120
MAX_ACTIVE_VIDEOS_PER_USER=3
# Times a single segment is re-generated after a provider-side failure (e.g. safety block) before giving up.
SEGMENT_PROVIDER_RETRIES=2
# Crossfade at each seam, in seconds (0 = hard cut, drops the duplicated first frame instead).
STITCH_CROSSFADE_SECONDS=0.15
STITCH_FPS=24
# Text prepended to prompts for segments 2..N, which receive the previous segment's last frame.
CONTINUATION_PREFIX=Continue this exact shot seamlessly from the provided frame, keeping the same characters, lighting and camera style.

# ---- Workers ----
SEGMENT_WORKER_CONCURRENCY=4
FINALIZE_WORKER_CONCURRENCY=1

# ---- Storage: local | s3 ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
# S3_BUCKET=videos
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
